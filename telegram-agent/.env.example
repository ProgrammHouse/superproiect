# Скопируйте этот файл в .env и впишите свои ключи.
# Токен бота: получите у @BotFather в Telegram (команда /newbot)
TELEGRAM_BOT_TOKEN=
# Ключ Claude API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Необязательные настройки
CLAUDE_MODEL=claude-opus-5-5
# Насколько глубоко модель думает: low (быстрее и дешевле), medium, high
CLAUDE_EFFORT=medium
# Сколько последних сообщений чата бот помнит
HISTORY_LIMIT=30
# Сколько минут бот молчит в чате после того, как вы сами там написали
OWNER_TAKEOVER_MINUTES=30
